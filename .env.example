# ── SERVER (Node.js hosting only) ──────────────────────
# SMTP — Hostinger email for contact form
SMTP_USER=admin@nazamllc.com
SMTP_PASS=your_hostinger_email_password

# OpenRouter — AI chatbot backend proxy
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: override default port (8080)
# PORT=8080

# ── CLIENT (Static hosting — baked in at build time) ──
# Copy these to client/.env before running npm run build
# VITE_OPENROUTER_API_KEY=your_openrouter_api_key
