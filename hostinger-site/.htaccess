ErrorDocument 404 /404.html

# OAuth callback (/oauth/tiktok/callback). Served from a directory index, but
# WITHOUT Apache's DirectorySlash 301 to the trailing-slash form: an OAuth
# redirect arrives with ?auth_code=... and a redirect hop is an avoidable place
# for that to be dropped. This rewrite serves the file directly instead.
# The page is noindex and is not in sitemap.xml.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^oauth/tiktok/callback$ /oauth/tiktok/callback/index.html [L]
</IfModule>

# Deployment notes must never be publicly readable. UPLOAD-INSTRUCTIONS.txt was
# served at https://nazamllc.com/UPLOAD-INSTRUCTIONS.txt (HTTP 200) for as long
# as it sat in this folder. It now lives at DEPLOY.md in the repo root, outside
# the upload payload; this rule blocks any stale copy still on the server.
<FilesMatch "^(UPLOAD-INSTRUCTIONS\.txt|DEPLOY\.md|AGENTS\.md)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# NOTE: Strict-Transport-Security is deliberately NOT set here.
# https://www.nazamllc.com currently fails its TLS handshake and serves a
# Hostinger parking page over plain HTTP. Enabling HSTS before that is fixed
# would harden the broken state into a browser-cached rule.
